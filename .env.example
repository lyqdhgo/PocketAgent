# ===== PocketAgent 配置示例 =====
# 用法：复制本文件为 .env 并填写，然后运行 python -m pocketagent chat
# 说明：也可直接使用系统环境变量，.env 不会覆盖已存在的环境变量。

# ---------- 方案 1：DeepSeek（默认推荐）----------
# 在 https://platform.deepseek.com 申请 API Key
AGENT_API_KEY=sk-xxxxxxxxxxxxxxxx
AGENT_MODEL=deepseek-chat
AGENT_BASE_URL=https://api.deepseek.com

# ---------- 方案 2：OpenAI ----------
# AGENT_API_KEY=sk-xxxxxxxxxxxxxxxx
# AGENT_MODEL=gpt-4o-mini
# AGENT_BASE_URL=https://api.openai.com/v1

# ---------- 方案 3：Ollama（本地免费，无需 Key）----------
# 先本地启动：ollama pull qwen2.5:7b && ollama serve
# AGENT_API_KEY=
# AGENT_MODEL=qwen2.5:7b
# AGENT_BASE_URL=http://127.0.0.1:11434/v1

# ---------- 兼容变量（可选）----------
# 直接填写 DEEPSEEK_API_KEY 或 OPENAI_API_KEY 亦可被自动识别
# DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxx
